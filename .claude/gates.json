{
  "$comment": "Quality gates for the hooks in .claude/hooks/ and the /qa, /spec-build, /spec-check skills. `full` mirrors .github/workflows/ci.yml (minus the pincel-tauri job, AGENTS.md §10); `fast` runs in the Stop hook, filtered by `paths` (prefixes of changed repository paths). `needs` lists the ids a gate waits for; gates without needs between them run in parallel.",
  "fast": [
    {
      "id": "rust-fmt",
      "name": "rustfmt",
      "cwd": ".",
      "command": "cargo fmt --all -- --check",
      "fix": "cargo fmt --all",
      "paths": ["crates/", "src-tauri/", "Cargo.toml"],
      "needs": []
    },
    {
      "id": "rust-clippy",
      "name": "clippy",
      "cwd": ".",
      "command": "cargo clippy -p pincel-core -p pincel-effects -p aseprite-writer -p pincel-wasm -p pincel-image-core -p pincel-image-wasm --all-targets -- -D warnings",
      "paths": ["crates/", "Cargo.toml", "Cargo.lock"],
      "needs": []
    },
    {
      "id": "ui-lint",
      "name": "ui lint",
      "cwd": "ui",
      "command": "pnpm lint",
      "fix": "pnpm lint --fix",
      "paths": ["ui/"],
      "needs": []
    },
    {
      "id": "ui-check",
      "name": "ui type-check",
      "cwd": "ui",
      "command": "pnpm check",
      "paths": ["ui/"],
      "needs": []
    },
    {
      "id": "website-lint",
      "name": "website lint",
      "cwd": "website",
      "command": "pnpm lint",
      "fix": "pnpm lint --fix",
      "paths": ["website/"],
      "needs": []
    },
    {
      "id": "website-check",
      "name": "website type-check",
      "cwd": "website",
      "command": "pnpm check",
      "paths": ["website/"],
      "needs": []
    }
  ],
  "full": [
    {
      "id": "rust-fmt",
      "name": "rustfmt",
      "cwd": ".",
      "command": "cargo fmt --all -- --check",
      "fix": "cargo fmt --all",
      "needs": []
    },
    {
      "id": "rust-clippy",
      "name": "clippy",
      "cwd": ".",
      "command": "cargo clippy -p pincel-core -p pincel-effects -p aseprite-writer -p pincel-wasm -p pincel-image-core -p pincel-image-wasm --all-targets -- -D warnings",
      "needs": []
    },
    {
      "id": "rust-test",
      "name": "cargo test",
      "cwd": ".",
      "command": "cargo test -p pincel-core -p pincel-effects -p aseprite-writer -p pincel-wasm -p pincel-image-core -p pincel-image-wasm",
      "needs": ["rust-clippy"]
    },
    {
      "id": "generated-bindings",
      "name": "generated TS bindings current",
      "cwd": ".",
      "command": "git diff --exit-code -- ui/src/modes/image/core/generated/",
      "needs": ["rust-test"]
    },
    {
      "id": "ui-wasm",
      "name": "ui wasm build",
      "cwd": "ui",
      "command": "pnpm wasm:build",
      "needs": []
    },
    {
      "id": "ui-install",
      "name": "ui install",
      "cwd": "ui",
      "command": "pnpm install --frozen-lockfile",
      "needs": ["ui-wasm"]
    },
    {
      "id": "ui-lint",
      "name": "ui lint",
      "cwd": "ui",
      "command": "pnpm lint",
      "fix": "pnpm lint --fix",
      "needs": ["ui-install"]
    },
    {
      "id": "ui-check",
      "name": "ui type-check",
      "cwd": "ui",
      "command": "pnpm check",
      "needs": ["ui-install"]
    },
    {
      "id": "ui-build",
      "name": "ui build",
      "cwd": "ui",
      "command": "pnpm build",
      "needs": ["ui-install"]
    },
    {
      "id": "ui-e2e",
      "name": "ui e2e",
      "cwd": "ui",
      "command": "pnpm test:e2e",
      "needs": ["ui-build"]
    },
    {
      "id": "website-install",
      "name": "website install",
      "cwd": "website",
      "command": "pnpm install --frozen-lockfile",
      "needs": []
    },
    {
      "id": "website-lint",
      "name": "website lint",
      "cwd": "website",
      "command": "pnpm lint",
      "fix": "pnpm lint --fix",
      "needs": ["website-install"]
    },
    {
      "id": "website-check",
      "name": "website type-check",
      "cwd": "website",
      "command": "pnpm check",
      "needs": ["website-install"]
    },
    {
      "id": "website-build",
      "name": "website build",
      "cwd": "website",
      "command": "pnpm build",
      "needs": ["website-install"]
    }
  ],
  "suppressions": [
    "#[allow(",
    "#![allow(",
    "#[expect(",
    "#![expect(",
    "#[ignore",
    "@ts-ignore",
    "@ts-nocheck",
    "@ts-expect-error",
    "eslint-disable",
    "test.skip(",
    "test.fixme(",
    "test.only(",
    "describe.skip("
  ]
}
