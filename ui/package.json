{
  "name": "pincel-ui",
  "private": true,
  "version": "1.10.1",
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/check-wasm-pkg.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "wasm:build": "wasm-pack build ../crates/pincel-wasm --target web --dev --out-dir pkg --scope amigo-labs && wasm-pack build ../crates/pincel-image-wasm --target web --dev --out-dir pkg",
    "wasm:build:release": "wasm-pack build ../crates/pincel-wasm --target web --release --out-dir pkg --scope amigo-labs && wasm-pack build ../crates/pincel-image-wasm --target web --release --out-dir pkg",
    "wasm:build:scalar": "node scripts/wasm-build-scalar.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test:e2e": "playwright test",
    "perf": "playwright test -c playwright.perf.config.ts",
    "perf:check": "node e2e-perf/check-budgets.ts",
    "simd:check": "playwright test -c playwright.simd.config.ts"
  },
  "dependencies": {
    "@amigo-labs/pincel-wasm": "link:../crates/pincel-wasm/pkg",
    "@tauri-apps/api": "~2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "~2.5.0",
    "@tauri-apps/plugin-dialog": "~2.8.4",
    "pincel-image-wasm": "link:../crates/pincel-image-wasm/pkg"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "~2.12.4",
    "@types/node": "^26.6.6",
    "@webgpu/types": "^0.1.74",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.10.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-precaching": "^7.4.1"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  }
}
