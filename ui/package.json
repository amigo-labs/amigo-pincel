{
  "name": "pincel-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/check-wasm-pkg.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "wasm:build": "wasm-pack build ../crates/pincel-wasm --target web --dev --out-dir pkg && wasm-pack build ../crates/pincel-image-wasm --target web --dev --out-dir pkg",
    "wasm:build:release": "wasm-pack build ../crates/pincel-wasm --target web --release --out-dir pkg && wasm-pack build ../crates/pincel-image-wasm --target web --release --out-dir pkg",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-dialog": "~2.7.3",
    "pincel-image-wasm": "link:../crates/pincel-image-wasm/pkg",
    "pincel-wasm": "link:../crates/pincel-wasm/pkg"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "~2.11.5",
    "@types/node": "^22.20.5",
    "@webgpu/types": "^0.1.74",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^15.15.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.9.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-precaching": "^7.4.1"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  }
}
