      "unit": "ms",
      "owner": "performance-image-cache"
    },
    {
      "metric": "browser/image-pan-zoom-4k/frame-p95",
      "scenario": "Pan / zoom, Image 4K 10 layers (60 fps)",
      "max": 17,
      "unit": "ms",
      "owner": "performance-image-cache"
    },
    {
      "metric": "browser/image-recompose-4k/recompose-p50",
      "scenario": "Full recompose, Image 4K 10 layers (wasm)",
      "max": 100,
      "unit": "ms",
      "owner": "performance-image-kernel"
    },
    {
      "metric": "browser/pixel-pencil-256-z32/frame-p95",
      "scenario": "Pixel: pencil drag on 256x256 at zoom 32 (60 fps)",
      "max": 17,
      "unit": "ms",
      "owner": "performance-input-path"
    },
    {
      "metric": "browser/pixel-pencil-256-z32/dab-draw-latency-p95",
      "scenario": "Pixel: pencil drag on 256x256 at zoom 32, dab latency (pointer event received -> draw call)",
