# Cloudflare response headers for pincel.amigo-labs.dev (the editor at the root).
#
# Cloudflare Workers Static Assets reads this file (Cloudflare Pages
# `_headers` syntax) from the root of `[assets].directory` in the root
# wrangler.toml; scripts/web-site.sh copies it there.
# Docs: https://developers.cloudflare.com/workers/static-assets/headers/

# Vite emits hashed file names under /assets/; the service workers and
# the web app manifest must revalidate so a deploy reaches installed PWAs.
# /app/sw.js is the stand-in worker for copies from the /app/ days.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
/app/sw.js
  Cache-Control: public, max-age=0, must-revalidate
/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

# OCR language models (docs/specs/ocr-dialog.md): the path names the
# tessdata_fast version, so a file never changes. The desktop app fetches
# them from its own origin (tauri://localhost, http://tauri.localhost), so
# any origin may read them; they are public, unauthenticated files.
/ocr/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Content-Type: application/octet-stream

# HTML revalidates on every request so a deploy is visible immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Baseline security headers across the editor. Nothing here is meant to be
# framed, so DENY is safe.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()
