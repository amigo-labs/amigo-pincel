{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-v-in-tag": true,
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "draft": true,
  "force-tag-creation": true,
  "bootstrap-sha": "c31a957bbe46867681fab82e52a9157efaa62dfc",
  "pull-request-title-pattern": "chore: release pincel ${version}",
  "pull-request-header": "Automated release proposed by release-please. Merging this PR tags the version and builds and publishes the release (web bundle; Windows, macOS, Linux installers; signed updater artifacts; SHA256SUMS).",
  "changelog-sections": [
    {"type": "feat", "section": "Features"},
    {"type": "fix", "section": "Bug Fixes"},
    {"type": "perf", "section": "Performance Improvements"},
    {"type": "revert", "section": "Reverts"},
    {"type": "docs", "section": "Documentation", "hidden": true},
    {"type": "refactor", "section": "Code Refactoring", "hidden": true},
    {"type": "test", "section": "Tests", "hidden": true},
    {"type": "build", "section": "Build System", "hidden": true},
    {"type": "ci", "section": "Continuous Integration", "hidden": true},
    {"type": "chore", "section": "Miscellaneous", "hidden": true}
  ],
  "packages": {
    ".": {
      "package-name": "pincel",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {"type": "generic", "path": "Cargo.toml"},
        {"type": "json", "path": "ui/package.json", "jsonpath": "$.version"},
        {"type": "json", "path": "src-tauri/tauri.conf.json", "jsonpath": "$.version"}
      ]
    }
  }
}
